# ==============================================================================
# Quillhog Claime - Environment Variables Template
# ==============================================================================

# Helius RPC API Key for high-speed primary Solana Mainnet-Beta RPC connection
HELIUS_API_KEY=

# Comma-separated list of secondary Solana RPC endpoints for automatic failover
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com

# Analytics salt for daily salted SHA-256 cookieless IP hashing (0 PII)
# If unset, a random salt is generated on application boot
ANALYTICS_SALT=

# ntfy.sh topic for operational alerts and ledger digest push notifications
NTFY_TOPIC=

# Secret token required to query /api/stats endpoint
STATS_TOKEN=

# Path to persistent SQLite WAL ledger database
RECLAIM_DB_PATH=reclaim_vault.db

# Set to true when running behind trusted reverse proxy (Nginx, Cloudflare)
# to allow reading client IP from X-Forwarded-For or X-Real-IP
TRUST_PROXY_HEADERS=false
